# Maintainer: RishiSpace <rishikesh.giridhar@outlook.com>
# AUR release package. Requires a public GitHub tag: v$pkgver
#
#   git tag v1.0.5 && git push origin v1.0.5
#   makepkg -g >> PKGBUILD   # refresh sha256sums
#   makepkg --printsrcinfo > .SRCINFO
pkgname=enigmars-utils
pkgver=1.0.5
pkgrel=1
pkgdesc="Qt landing hub: tweaks, packages, kernels, and Secure Boot for Linux"
arch=('any')
url="https://github.com/RishiSpace/enigmars-utils"
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'polkit' 'qt6-base')
optdepends=(
  'sbctl: Secure Boot key enrollment'
  'ufw: firewall toggle'
  'plasma-discover: software center shortcut'
  'gnome-software: software center shortcut'
  'flatpak: extra app source'
)
provides=('enigmars-util')
conflicts=('enigmars-util')
source=("$pkgname-$pkgver.tar.gz::https://github.com/RishiSpace/enigmars-utils/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/enigmars-utils-$pkgver"
  DESTDIR="$pkgdir" PREFIX=/usr ./scripts/install.sh
}
